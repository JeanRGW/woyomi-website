---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import mediaDetail from '../assets/media-detail.png'
import readerManga from '../assets/reader-manga.png'
import browseMobile from '../assets/browse-mobile.png'
import libraryMobile from '../assets/library-mobile.png'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section id="showcase" class="scroll-mt-16 border-t border-line-soft/80 bg-surface/25 py-16 md:py-24">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    {/* Header */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-12">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          <Icon name="monitor" size={14} />
          <span>{t('showcase.tagline')}</span>
        </div>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-fg sm:text-4xl md:text-5xl">
          {t('showcase.title')}
        </h2>
      </div>
      <p class="max-w-md text-sm sm:text-base leading-relaxed text-muted">
        {t('showcase.subtitle')}
      </p>
    </div>

    {/* Desktop Experience Highlights (2 columns) */}
    <div class="grid gap-6 lg:grid-cols-2">
      {/* Card 1: Media Detail & Chapter Deck */}
      <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-line-soft bg-surface/70 p-5 sm:p-6 transition-all hover:border-line">
        <div>
          <div class="flex items-center justify-between gap-2 pb-4 border-b border-line-soft/60">
            <span class="font-mono text-xs font-semibold text-fg">{t('showcase.card1.num')}</span>
            <span class="rounded bg-manga-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-manga">{t('showcase.card1.badge')}</span>
          </div>
          <p class="mt-3 text-sm text-muted">
            {t('showcase.card1.desc')}
          </p>
        </div>
        <figure class="mt-5 overflow-hidden rounded-xl border border-line bg-ink shadow-xl">
          <Image
            src={mediaDetail}
            alt="woyomi media detail view with demo chapters and tags"
            width={960}
            height={600}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover transition-transform duration-300 hover:scale-[1.01]"
          />
        </figure>
      </div>

      {/* Card 2: Manga & Reader Canvas */}
      <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-line-soft bg-surface/70 p-5 sm:p-6 transition-all hover:border-line">
        <div>
          <div class="flex items-center justify-between gap-2 pb-4 border-b border-line-soft/60">
            <span class="font-mono text-xs font-semibold text-fg">{t('showcase.card2.num')}</span>
            <span class="rounded bg-anime-soft px-2 py-0.5 font-mono text-[11px] font-semibold text-anime">{t('showcase.card2.badge')}</span>
          </div>
          <p class="mt-3 text-sm text-muted">
            {t('showcase.card2.desc')}
          </p>
        </div>
        <figure class="mt-5 overflow-hidden rounded-xl border border-line bg-ink shadow-xl">
          <Image
            src={readerManga}
            alt="woyomi reader canvas showing a Pepper & Carrot demo page (CC BY 4.0)"
            width={960}
            height={600}
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover transition-transform duration-300 hover:scale-[1.01]"
          />
        </figure>
      </div>
    </div>

    {/* Mobile Section Callout */}
    <div class="mt-8 overflow-hidden rounded-2xl border border-line-soft bg-gradient-to-r from-surface/90 via-surface/60 to-ink p-6 sm:p-8">
      <div class="grid items-center gap-8 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-series/30 bg-series-soft px-2.5 py-0.5 font-mono text-xs font-semibold text-series">
            <Icon name="smartphone" size={13} />
            {t('showcase.mobile.badge')}
          </span>
          <h3 class="mt-4 text-2xl font-bold text-fg sm:text-3xl">
            {t('showcase.mobile.title')}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            {t('showcase.mobile.desc')}
          </p>
          <ul class="mt-5 space-y-2 text-xs font-medium text-muted">
            <li class="flex items-center gap-2">
              <Icon name="check" size={14} class="text-ok" />
              <span>{t('showcase.mobile.list1')}</span>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={14} class="text-ok" />
              <span>{t('showcase.mobile.list2')}</span>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="check" size={14} class="text-ok" />
              <span>{t('showcase.mobile.list3')}</span>
            </li>
          </ul>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 md:col-span-6 lg:col-span-7">
          <div class="w-40 sm:w-52 rounded-2xl border-2 border-line bg-ink p-1 shadow-2xl transition-transform hover:-translate-y-1">
            <div class="py-1 text-center font-mono text-[10px] text-muted border-b border-line-soft mb-1">{t('showcase.mobile.railBrowse')}</div>
            <Image
              src={browseMobile}
              alt="woyomi mobile browse screen with demo comics"
              width={260}
              loading="eager"
              decoding="async"
              class="w-full rounded-xl"
            />
          </div>
          <div class="w-40 sm:w-52 rounded-2xl border-2 border-line bg-ink p-1 shadow-2xl transition-transform hover:-translate-y-1">
            <div class="py-1 text-center font-mono text-[10px] text-muted border-b border-line-soft mb-1">{t('showcase.mobile.railLibrary')}</div>
            <Image
              src={libraryMobile}
              alt="woyomi mobile library screen with demo titles"
              width={260}
              loading="eager"
              decoding="async"
              class="w-full rounded-xl"
            />
          </div>
        </div>
      </div>
    </div>

    <p class="mt-8 text-center text-[11px] leading-relaxed text-faint">
      {t('showcase.credits')}
    </p>
  </div>
</section>
