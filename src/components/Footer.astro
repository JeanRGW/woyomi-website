---
import { Image } from 'astro:assets'
import logo from '../assets/woyomi-logo-horizontal-reverse.svg'
import Icon from './Icon.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const columns = [
  {
    title: t('footer.colProject'),
    links: [
      { label: t('footer.github'), href: 'https://github.com/JeanRGW/woyomi' },
      { label: t('footer.releases'), href: 'https://github.com/JeanRGW/woyomi/releases' },
      { label: t('footer.issues'), href: 'https://github.com/JeanRGW/woyomi/issues' }
    ]
  },
  {
    title: t('footer.colExtensibility'),
    links: [
      { label: t('footer.pluginGuide'), href: 'https://github.com/JeanRGW/woyomi#building-plugins' },
      { label: t('footer.selfHosted'), href: 'https://github.com/JeanRGW/woyomi#optional-self-hosted-backend' },
      { label: t('footer.license'), href: 'https://github.com/JeanRGW/woyomi/blob/main/LICENSE' }
    ]
  },
  {
    title: t('footer.colLineage'),
    links: [
      { label: 'Aniyomi Project', href: 'https://github.com/aniyomiorg/aniyomi' },
      { label: 'Mihon Reader', href: 'https://github.com/mihonapp/mihon' },
      { label: 'Tauri 2 Framework', href: 'https://v2.tauri.app' }
    ]
  }
]
---

<footer class="border-t border-line-soft/80 bg-ink-deep/60">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 md:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <div class="max-w-sm">
        <Image src={logo} alt="woyomi" width={115} height={28} class="h-6 w-auto" />
        <p class="mt-4 text-xs leading-relaxed text-muted">
          {t('footer.desc')}
        </p>
        <div class="mt-4 flex items-center gap-2 font-mono text-[11px] text-faint">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span>{t('footer.status')}</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10">
        {
          columns.map((col) => (
            <div>
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-fg">
                {col.title}
              </h3>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-xs text-muted transition-colors hover:text-fg"
                    >
                      <span>{link.label}</span>
                      <Icon name="externalLink" size={11} class="text-faint" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-line-soft/60 pt-8 text-center text-xs text-muted sm:flex-row sm:text-left">
      <p class="inline-flex items-center gap-1.5" set:html={t('footer.heartStatement')} />
      <p>{t('footer.copyright', { year: new Date().getFullYear() })}</p>
    </div>
  </div>
</footer>
