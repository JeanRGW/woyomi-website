---
import { Image } from 'astro:assets'
import logo from '../assets/woyomi-logo-horizontal-reverse.svg'
import Icon from './Icon.astro'

const columns = [
  {
    title: 'Project',
    links: [
      { label: 'GitHub Repository', href: 'https://github.com/JeanRGW/woyomi' },
      { label: 'Releases & Changelogs', href: 'https://github.com/JeanRGW/woyomi/releases' },
      { label: 'Issue Tracker', href: 'https://github.com/JeanRGW/woyomi/issues' }
    ]
  },
  {
    title: 'Extensibility',
    links: [
      { label: 'Plugin SDK Guide', href: 'https://github.com/JeanRGW/woyomi#building-plugins' },
      { label: 'Self-Hosted Sync Backend', href: 'https://github.com/JeanRGW/woyomi#optional-self-hosted-backend' },
      { label: 'Apache 2.0 License', href: 'https://github.com/JeanRGW/woyomi/blob/main/LICENSE' }
    ]
  },
  {
    title: 'Lineage & Credits',
    links: [
      { label: 'Aniyomi Project', href: 'https://github.com/aniyomiorg/aniyomi' },
      { label: 'Mihon Reader', href: 'https://github.com/mihonapp/mihon' },
      { label: 'Tauri 2 Framework', href: 'https://v2.tauri.app' }
    ]
  }
]
---

<footer class="border-t border-line-soft/80 bg-ink-deep/60">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 md:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:justify-between">
      <div class="max-w-sm">
        <Image src={logo} alt="woyomi" width={115} height={28} class="h-6 w-auto" />
        <p class="mt-4 text-xs leading-relaxed text-muted">
          A local-first, multi-format media reader and streaming player. Ships with zero bundled sources — install and manage only the sources you trust.
        </p>
        <div class="mt-4 flex items-center gap-2 font-mono text-[11px] text-faint">
          <span class="size-1.5 rounded-full bg-ok"></span>
          <span>Open source · Apache-2.0 · Local SQLite</span>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3" aria-label="Footer Navigation">
        {
          columns.map((column) => (
            <div>
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-fg/90">
                {column.title}
              </h3>
              <ul class="mt-3.5 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-muted transition-colors hover:text-fg"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line-soft/60 pt-6 text-xs text-faint">
      <p>© {new Date().getFullYear()} JeanRGW · Released under Apache License 2.0</p>
      <p class="inline-flex items-center gap-1.5">
        Crafted with <Icon name="heart" size={13} class="text-manga" /> because great stories should be free for everyone
      </p>
    </div>
  </div>
</footer>
