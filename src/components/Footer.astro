---
import { Image } from 'astro:assets'
import logo from '../assets/woyomi-logo-horizontal-reverse.svg'
import Icon from './Icon.astro'

const columns = [
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: 'https://github.com/JeanRGW/woyomi' },
      { label: 'Releases', href: 'https://github.com/JeanRGW/woyomi/releases' },
      { label: 'Issues', href: 'https://github.com/JeanRGW/woyomi/issues' }
    ]
  },
  {
    title: 'Resources',
    links: [
      { label: 'Build a plugin', href: 'https://github.com/JeanRGW/woyomi#building-plugins' },
      { label: 'Self-hosted server', href: 'https://github.com/JeanRGW/woyomi#optional-self-hosted-backend' },
      { label: 'License (Apache 2.0)', href: 'https://github.com/JeanRGW/woyomi/blob/main/LICENSE' }
    ]
  },
  {
    title: 'Inspired by',
    links: [
      { label: 'Aniyomi', href: 'https://github.com/aniyomiorg/aniyomi' },
      { label: 'Mihon', href: 'https://github.com/mihonapp/mihon' }
    ]
  }
]
---

<footer class="border-t border-line-soft">
  <div class="mx-auto w-full max-w-6xl px-4 py-12 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <Image src={logo} alt="woyomi" width={120} height={30} />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          A multi-source media reader and player. Ships with zero bundled sources — install the ones
          you trust.
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3" aria-label="Footer">
        {
          columns.map((column) => (
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-faint">{column.title}</h3>
              <ul class="mt-3 space-y-2">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm font-medium text-muted transition-colors hover:text-fg">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line-soft pt-6 text-[13px] text-faint">
      <p>© {new Date().getFullYear()} woyomi contributors · Apache License 2.0</p>
      <p class="ml-auto inline-flex items-center gap-1.5">
        Made with <Icon name="heart" size={13} class="text-accent" /> and TypeScript
      </p>
    </div>
  </div>
</footer>
