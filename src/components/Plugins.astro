---
import Icon from './Icon.astro'

const architecturePillars = [
  {
    icon: 'shield',
    title: 'Isolated Web Worker Sandbox',
    body: 'Each source plugin runs inside its own isolated Web Worker thread with zero raw DOM access and strict memory isolation.'
  },
  {
    icon: 'refresh',
    title: 'Injected SourceContext',
    body: 'Plugins talk to an injected context interface with rate limiting, header customization, and built-in HTML/JSON parsers.'
  },
  {
    icon: 'check',
    title: 'SHA-256 Integrity Verification',
    body: 'Remote plugin packages are cryptographically validated against manifest hashes before executing in your client.'
  },
  {
    icon: 'layers',
    title: 'Decentralized Static Repositories',
    body: 'Plugin repositories can live anywhere — GitHub Releases, Cloudflare R2, or any static HTTPS endpoint.'
  }
]
---

<section id="plugins" class="scroll-mt-16 border-t border-line-soft/80 py-14 sm:py-16 md:py-24 overflow-hidden">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    {/* Header */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-10 sm:pb-12">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          <Icon name="cpu" size={14} />
          <span>Extensible Architecture</span>
        </div>
        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-fg sm:text-4xl md:text-5xl">
          Zero bundled sources. 100% extensible.
        </h2>
      </div>
      <p class="max-w-md text-xs sm:text-sm md:text-base leading-relaxed text-muted">
        Woyomi is an open player engine. It ships with no pre-bundled scrapers — you install and manage only the sources you trust.
      </p>
    </div>

    {/* Split Architecture: Pillars + Live Code Inspector */}
    <div class="grid gap-6 sm:gap-8 lg:grid-cols-12 items-start min-w-0 w-full">
      {/* Pillars (5 cols) */}
      <div class="lg:col-span-5 space-y-3 sm:space-y-4 min-w-0 w-full">
        {
          architecturePillars.map((pillar) => (
            <div class="rounded-xl border border-line-soft bg-surface/50 p-4 transition-colors hover:border-line hover:bg-surface-2/60">
              <div class="flex items-start gap-3.5">
                <div class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent mt-0.5">
                  <Icon name={pillar.icon as any} size={16} />
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-sm font-bold text-fg">{pillar.title}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-muted">{pillar.body}</p>
                </div>
              </div>
            </div>
          ))
        }

        <div class="pt-2">
          <a
            href="https://github.com/JeanRGW/woyomi#building-plugins"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-surface-2 px-4 py-2 text-xs font-semibold text-accent transition-colors hover:bg-surface-3 hover:text-fg"
          >
            <Icon name="code" size={14} />
            <span>Read Plugin SDK Docs</span>
            <Icon name="chevronRight" size={13} />
          </a>
        </div>
      </div>

      {/* Code Inspector (7 cols) */}
      <div class="lg:col-span-7 min-w-0 w-full overflow-hidden">
        <div class="overflow-hidden rounded-2xl border border-line bg-[#040810] shadow-2xl ring-1 ring-white/5 min-w-0 w-full">
          {/* Editor Tab bar */}
          <div class="flex flex-wrap items-center justify-between border-b border-line-soft bg-surface/40 px-3 sm:px-4 py-2 sm:py-2.5 gap-2">
            <div class="flex items-center gap-2 font-mono text-[11px] sm:text-xs text-muted">
              <span class="size-2 rounded-full bg-accent"></span>
              <span class="text-fg font-medium">source-manifest.ts</span>
              <span class="text-faint">· TypeScript</span>
            </div>
            <span class="font-mono text-[10px] uppercase text-muted/70 tracking-wider">
              @woyomi/plugin-sdk
            </span>
          </div>

          {/* Syntax Highlighted Code (Horizontal scrollable on narrow screens) */}
          <pre class="overflow-x-auto p-3.5 sm:p-5 font-mono text-[11px] sm:text-[12.5px] leading-relaxed text-[#c9d1d9] max-w-full"><code class="inline-block min-w-full"><span class="text-[#ff7b72]">import</span> &#123; <span class="text-[#79c0ff]">MediaSource</span>, <span class="text-[#79c0ff]">MediaItem</span>, <span class="text-[#79c0ff]">SourceContext</span> &#125; <span class="text-[#ff7b72]">from</span> <span class="text-[#a5d6ff]'">'@woyomi/plugin-sdk'</span>

<span class="text-[#ff7b72]">export class</span> <span class="text-[#ffa657]">MangaVaultSource</span> <span class="text-[#ff7b72]">implements</span> <span class="text-[#79c0ff]">MediaSource</span> &#123;
  <span class="text-[#ff7b72]">readonly</span> id = <span class="text-[#a5d6ff]'">'community.mangavault'</span>
  <span class="text-[#ff7b72]">readonly</span> name = <span class="text-[#a5d6ff]'">'Manga Vault'</span>
  <span class="text-[#ff7b72]">readonly</span> mediaType = <span class="text-[#a5d6ff]'">'manga'</span>
  <span class="text-[#ff7b72]">readonly</span> apiVersion = <span class="text-[#79c0ff]">1</span>

  <span class="text-[#8b949e]">// Discovers home rails with injected transport</span>
  <span class="text-[#ff7b72]">async</span> <span class="text-[#d2a8ff]">getTrending</span>(ctx: <span class="text-[#79c0ff]">SourceContext</span>): <span class="text-[#79c0ff]">Promise</span>&lt;<span class="text-[#79c0ff]">MediaItem</span>[]&gt; &#123;
    <span class="text-[#ff7b72]">const</span> res = <span class="text-[#ff7b72]">await</span> ctx.<span class="text-[#d2a8ff]">fetch</span>(<span class="text-[#a5d6ff]'">'https://api.vault.org/v1/popular'</span>)
    <span class="text-[#ff7b72]">const</span> json = <span class="text-[#ff7b72]">await</span> res.<span class="text-[#d2a8ff]">json</span>()
    <span class="text-[#ff7b72]">return</span> json.items.<span class="text-[#d2a8ff]">map</span>((item: <span class="text-[#79c0ff]">any</span>) =&gt; (&#123;
      id: item.slug,
      title: item.title,
      coverUrl: item.poster_image,
      format: <span class="text-[#a5d6ff]'">'manga'</span>,
      status: item.is_completed ? <span class="text-[#a5d6ff]'">'completed'</span> : <span class="text-[#a5d6ff]'">'ongoing'</span>
    &#125;))
  &#125;
&#125;</code></pre>

          {/* Architecture Footer */}
          <div class="border-t border-line-soft/80 bg-surface/20 px-3.5 sm:px-5 py-2.5 sm:py-3 flex flex-wrap items-center justify-between text-[11px] sm:text-xs text-muted gap-2">
            <span class="font-mono text-[10px] sm:text-[11px]">Sandboxed in Web Worker runtime</span>
            <span class="font-mono text-[10px] sm:text-[11px] text-ok">✓ Type-safe API contracts</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
