---
import Icon from './Icon.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const platforms = [
  {
    name: 'Windows',
    tag: 'x64 / NSIS Installer',
    status: t('hero.previewBadge'),
    statusClass: 'text-accent bg-accent-soft border-accent/30',
    desc: t('download.windows.desc'),
    href: 'https://github.com/JeanRGW/woyomi/releases',
    buttonText: t('download.windows.btn'),
    icon: 'monitor'
  },
  {
    name: 'Linux',
    tag: 'AppImage / .deb / .rpm',
    status: t('hero.previewBadge'),
    statusClass: 'text-accent bg-accent-soft border-accent/30',
    desc: t('download.linux.desc'),
    href: 'https://github.com/JeanRGW/woyomi/releases',
    buttonText: t('download.linux.btn'),
    icon: 'monitor'
  },
  {
    name: 'Android',
    tag: 'ARM64 APK',
    status: t('hero.previewBadge'),
    statusClass: 'text-accent bg-accent-soft border-accent/30',
    desc: t('download.android.desc'),
    href: 'https://github.com/JeanRGW/woyomi/releases',
    buttonText: t('download.android.btn'),
    icon: 'smartphone'
  }
]
---

<section id="download" class="scroll-mt-16 border-t border-line-soft/80 bg-surface/25 py-14 sm:py-16 md:py-24">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-10 sm:pb-12">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          <Icon name="download" size={14} />
          <span>{t('download.tagline')}</span>
        </div>
        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-fg sm:text-4xl md:text-5xl">
          {t('download.title')}
        </h2>
      </div>
      <p class="max-w-md text-xs sm:text-sm md:text-base leading-relaxed text-muted">
        {t('download.subtitle')}
      </p>
    </div>

    {/* Platform Release Cards (3 columns on desktop, 1 on mobile) */}
    <div class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        platforms.map((p) => (
          <div class="flex flex-col justify-between rounded-2xl border border-line-soft bg-surface/70 p-5 sm:p-6 transition-all duration-200 hover:border-line hover:bg-surface-2/70">
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-lg sm:text-xl font-bold text-fg">{p.name}</h3>
                <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[10.5px] font-semibold ${p.statusClass}`}>
                  {p.status}
                </span>
              </div>
              <div class="mt-1 font-mono text-[11px] text-muted">{p.tag}</div>
              <p class="mt-3 text-xs leading-relaxed text-muted">{p.desc}</p>
            </div>

            <div class="mt-5 pt-4 border-t border-line-soft/60">
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-xs font-semibold text-white shadow-sm shadow-accent/25 transition-all hover:bg-accent-deep active:scale-[0.98]"
              >
                <Icon name="download" size={14} />
                <span>{p.buttonText}</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    {/* Build From Source Terminal Frame */}
    <div class="mt-6 sm:mt-8 overflow-hidden rounded-2xl border border-line bg-[#040810] shadow-xl">
      <div class="flex flex-wrap items-center justify-between border-b border-line-soft bg-surface/40 px-4 py-3 sm:px-5 gap-3">
        <div class="flex items-center gap-2.5">
          <div class="grid size-6 sm:size-7 place-items-center rounded-lg bg-surface-3 text-fg">
            <Icon name="terminal" size={13} />
          </div>
          <div>
            <span class="font-mono text-xs font-semibold text-fg">{t('download.buildTitle')}</span>
            <span class="hidden sm:inline ml-2 font-mono text-[11px] text-muted">{t('download.buildRequirements')}</span>
          </div>
        </div>

        <button
          type="button"
          id="copy-build-cmd"
          data-copied-text={t('download.copied')}
          data-default-text={t('download.copyCmd')}
          class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface/60 px-2.5 py-1 text-[11px] sm:text-xs font-mono font-medium text-muted transition-all hover:border-accent hover:text-fg active:scale-95"
        >
          <Icon name="copy" size={13} />
          <span id="copy-text">{t('download.copyCmd')}</span>
        </button>
      </div>

      <div class="p-4 sm:p-5 font-mono text-[11.5px] sm:text-xs md:text-[13px] leading-relaxed text-[#c9d1d9] overflow-x-auto">
        <div class="text-faint/80"># 1. Clone repository</div>
        <div class="text-fg whitespace-nowrap"><span class="text-accent select-none">$ </span>git clone https://github.com/JeanRGW/woyomi.git</div>
        <div class="mt-2.5 sm:mt-3 text-faint/80"># 2. Install dependencies & build packages</div>
        <div class="text-fg whitespace-nowrap"><span class="text-accent select-none">$ </span>cd woyomi &amp;&amp; pnpm install &amp;&amp; pnpm build</div>
        <div class="mt-2.5 sm:mt-3 text-faint/80"># 3. Launch Tauri desktop app in dev mode</div>
        <div class="text-fg whitespace-nowrap"><span class="text-accent select-none">$ </span>pnpm --filter @woyomi/app tauri dev</div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCopyButton() {
    const btn = document.getElementById('copy-build-cmd');
    const label = document.getElementById('copy-text');
    if (!btn || !label) return;

    const defaultText = btn.getAttribute('data-default-text') || 'Copy commands';
    const copiedText = btn.getAttribute('data-copied-text') || 'Copied!';
    const cmd = `git clone https://github.com/JeanRGW/woyomi.git\ncd woyomi && pnpm install && pnpm build\npnpm --filter @woyomi/app tauri dev`;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        label.textContent = copiedText;
        btn.classList.add('border-ok', 'text-ok');
        setTimeout(() => {
          label.textContent = defaultText;
          btn.classList.remove('border-ok', 'text-ok');
        }, 2000);
      } catch (e) {
        console.error(e);
      }
    });
  }

  initCopyButton();
  document.addEventListener('astro:page-load', initCopyButton);
</script>
