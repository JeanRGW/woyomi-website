---
import Icon from './Icon.astro'
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const mediums = [
  {
    id: 'manga',
    accent: 'manga',
    title: t('features.manga.title'),
    subtitle: t('features.manga.subtitle'),
    description: t('features.manga.desc'),
    tags: [
      t('features.manga.tag1'),
      t('features.manga.tag2'),
      t('features.manga.tag3'),
      t('features.manga.tag4')
    ],
    badgeColor: 'border-manga/30 bg-manga-soft text-manga'
  },
  {
    id: 'anime',
    accent: 'anime',
    title: t('features.anime.title'),
    subtitle: t('features.anime.subtitle'),
    description: t('features.anime.desc'),
    tags: [
      t('features.anime.tag1'),
      t('features.anime.tag2'),
      t('features.anime.tag3'),
      t('features.anime.tag4')
    ],
    badgeColor: 'border-anime/30 bg-anime-soft text-anime'
  },
  {
    id: 'novel',
    accent: 'novel',
    title: t('features.novel.title'),
    subtitle: t('features.novel.subtitle'),
    description: t('features.novel.desc'),
    tags: [
      t('features.novel.tag1'),
      t('features.novel.tag2'),
      t('features.novel.tag3'),
      t('features.novel.tag4')
    ],
    badgeColor: 'border-novel/30 bg-novel-soft text-novel'
  },
  {
    id: 'cinema',
    accent: 'cinema',
    title: t('features.cinema.title'),
    subtitle: t('features.cinema.subtitle'),
    description: t('features.cinema.desc'),
    tags: [
      t('features.cinema.tag1'),
      t('features.cinema.tag2'),
      t('features.cinema.tag3'),
      t('features.cinema.tag4')
    ],
    badgeColor: 'border-cinema/30 bg-cinema-soft text-cinema'
  }
]
---

<section id="formats" class="scroll-mt-16 border-t border-line-soft/80 py-16 md:py-24">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 md:px-8">
    {/* Section Header */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 pb-12">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          <Icon name="layers" size={14} />
          <span>{t('features.tagline')}</span>
        </div>
        <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-fg sm:text-4xl md:text-5xl">
          {t('features.title')}
        </h2>
      </div>
      <p class="max-w-md text-sm sm:text-base leading-relaxed text-muted">
        {t('features.subtitle')}
      </p>
    </div>

    {/* Mediums 2x2 Bento */}
    <div class="grid gap-5 sm:grid-cols-2">
      {
        mediums.map((item, index) => (
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-line-soft bg-surface/60 p-6 sm:p-7 transition-all duration-200 hover:border-line hover:bg-surface-2/70">
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 font-mono text-xs font-semibold ${item.badgeColor}`}>
                  {item.title}
                </span>
                <span class="font-mono text-xs text-faint">0{index + 1}</span>
              </div>

              <h3 class="mt-5 text-xl font-bold text-fg sm:text-2xl">
                {item.subtitle}
              </h3>

              <p class="mt-2.5 text-sm leading-relaxed text-muted">
                {item.description}
              </p>
            </div>

            <div class="mt-6 flex flex-wrap gap-1.5 border-t border-line-soft/60 pt-4">
              {item.tags.map((tag) => (
                <span class="rounded-md bg-ink/60 px-2 py-1 font-mono text-[11px] text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    {/* Dual Underpinning Pillars: Universal Vault & Offline Engine */}
    <div class="mt-5 grid gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-line-soft bg-gradient-to-br from-surface/80 to-ink p-6 sm:p-7">
        <div class="flex items-center gap-3">
          <div class="grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
            <Icon name="library" size={20} />
          </div>
          <div>
            <h4 class="text-base font-bold text-fg">{t('features.vault.title')}</h4>
            <p class="text-xs text-muted">{t('features.vault.subtitle')}</p>
          </div>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted" set:html={t('features.vault.desc')} />
      </div>

      <div class="rounded-2xl border border-line-soft bg-gradient-to-br from-surface/80 to-ink p-6 sm:p-7">
        <div class="flex items-center gap-3">
          <div class="grid size-10 place-items-center rounded-xl bg-ok-soft text-ok">
            <Icon name="download" size={20} />
          </div>
          <div>
            <h4 class="text-base font-bold text-fg">{t('features.offline.title')}</h4>
            <p class="text-xs text-muted">{t('features.offline.subtitle')}</p>
          </div>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted">
          {t('features.offline.desc')}
        </p>
      </div>
    </div>
  </div>
</section>
