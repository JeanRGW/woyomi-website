  ]
} as const

export type IconName = keyof typeof paths

interface Props extends HTMLAttributes<'svg'> {
  name: IconName
  size?: number
}

const { name, size = 18, ...rest } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
>
  {
    paths[name].map((el: any) => {
      switch (el.tag) {
        case 'circle':
          return <circle {...el.attrs} />
        case 'rect':
          return <rect {...el.attrs} />
        case 'line':
          return <line {...el.attrs} />
        case 'polyline':
          return <polyline {...el.attrs} />
        case 'polygon':
          return <polygon {...el.attrs} />
        default:
          return <path {...el.attrs} />
      }
    })
  }
</svg>
