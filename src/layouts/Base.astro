---
import '../styles/global.css'
import { languages, defaultLang, type SupportedLanguage } from '../i18n/ui'
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import { RELEASE } from '../config'

interface Props {
  title?: string
  description?: string
  lang?: SupportedLanguage
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)

const title = Astro.props.title || t('meta.title')
const description = Astro.props.description || t('meta.description')
const canonical = new URL(Astro.url.pathname, Astro.site)

const ogLocales: Record<SupportedLanguage, string> = {
  en: 'en_US',
  'pt-br': 'pt_BR',
  es: 'es_ES',
  id: 'id_ID',
  fr: 'fr_FR',
  ru: 'ru_RU'
}
const ogLocale = ogLocales[currentLang] || 'en_US'

const altUrls = (Object.entries(languages) as [SupportedLanguage, (typeof languages)[SupportedLanguage]][]).map(
  ([code, data]) => ({
    code,
    href: new URL(code === 'en' ? '/' : `/${code}/`, Astro.site),
    hreflang: data.htmlLang
  })
)

const site = Astro.site ?? new URL('https://woyomi.rgw.app')
const structuredDataJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).toString(),
      url: new URL('/', site).toString(),
      name: 'woyomi',
      inLanguage: languages[currentLang].htmlLang
    },
    {
      '@type': 'SoftwareApplication',
      '@id': new URL('/#app', site).toString(),
      name: 'woyomi',
      alternateName: 'woyomi media reader and player',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Windows, Linux, Android',
      softwareVersion: RELEASE.version,
      url: new URL('/', site).toString(),
      downloadUrl: RELEASE.releasesUrl,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      inLanguage: languages[currentLang].htmlLang,
      description,
      author: { '@type': 'Person', name: 'JeanRGW', url: 'https://rgw.app' }
    }
  ]
}).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang={languages[currentLang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Auto-detect browser language and redirect from root '/' without flicker */}
    <script is:inline>
      (function () {
        try {
          var p = window.location.pathname;
          if (p === '/' || p === '') {
            var locales = { 'pt-br': 'pt', es: 'es', id: 'id', fr: 'fr', ru: 'ru' };
            var stored = localStorage.getItem('woyomi_lang');
            if (stored && locales[stored]) {
              window.location.replace('/' + stored + '/' + window.location.search + window.location.hash);
              return;
            }
            if (!stored) {
              var langs = navigator.languages || [navigator.language || ''];
              var primary = ((langs[0] || '') || '').toLowerCase();
              if (primary.indexOf('en') === 0) {
                return;
              }
              for (var i = 0; i < langs.length; i++) {
                var l = (langs[i] || '').toLowerCase();
                for (var code in locales) {
                  if (l.indexOf(locales[code]) === 0) {
                    window.location.replace('/' + code + '/' + window.location.search + window.location.hash);
                    return;
                  }
                }
              }
            }
          }
        } catch (e) {}
      })();
    </script>

    {/* Alternate language tags for SEO */}
    {
      altUrls.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={altUrls.find((alt) => alt.code === defaultLang)?.href} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#071224" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="woyomi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
  </head>
  <body>
    <slot />
  </body>
</html>
